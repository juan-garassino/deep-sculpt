# Keys-only sample generated from the real env file (values never committed).
# Copy to the real filename and fill in values locally.

# DeepSculpt Docker Compose — local development defaults
# Copy to .env and customize as needed

# MLflow (set by docker-compose, override here if running standalone)
MLFLOW_TRACKING_URI=https://...
MLFLOW_EXPERIMENT=

# Storage mode: "local" saves to /app/models volume, any other value uses GCS
MODELS_BUCKET=
LOCAL_MODELS_DIR=

# Training mode
TRAINING_MODE=
MODEL_TYPE=

# Model
NOISE_DIM=
VOID_DIM=
COLOR_MODE=

# Training hyperparameters
TRAIN_LR=
TRAIN_EPOCHS=
TRAIN_BATCH_SIZE=
TRAIN_SEED=
